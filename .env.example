# =============================================================
# Environment variables template.
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` file.
# =============================================================

# --- Trading platform (only if/when we connect to a real exchange) ---
# READ-ONLY keys only. NEVER enable withdrawal permissions.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# --- Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- App config ---
LOG_LEVEL=INFO
TRADING_MODE=paper        # paper | live
SYMBOL=BTC/USDT
TIMEFRAME=1h
